# DataFlow Environment Configuration
# Copy this file to .env and customize for your setup

# OpenAI Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here

# DataFlow API Configuration
DATAFLOW_API_HOST=0.0.0.0
DATAFLOW_API_PORT=8000
DATAFLOW_API_URL=http://localhost:8000

# DataFlow UI Configuration
DATAFLOW_UI_HOST=0.0.0.0
DATAFLOW_UI_PORT=8501
DATAFLOW_UI_URL=http://localhost:8501

# Spark Configuration
SPARK_APP_NAME=DataFlow
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/dataflow.log

# Data Storage
DATA_DIR=./data
EXPORT_DIR=./data/exports
IMPORT_DIR=./data/imports
DATAFLOW_DATASET_STORAGE_PATH=./data/datasets

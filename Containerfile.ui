# DataFlow UI Dockerfile
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64
ENV PATH=$JAVA_HOME/bin:$PATH

# Install system dependencies
RUN apt-get update && apt-get install -y \
    openjdk-21-jre-headless \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock LICENSE README.md ./
COPY dataflow/ ./dataflow/
# Force rebuild by adding timestamp
RUN echo "Build timestamp: $(date)" > /tmp/build_info
# Create empty .env file if it doesn't exist
RUN touch .env

# Install Python dependencies
RUN pip install uv && \
    uv sync --frozen

# Expose UI port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Start the UI server
CMD ["uv", "run", "streamlit", "run", "dataflow/ui.py", "--server.address", "0.0.0.0", "--server.port", "8501"]

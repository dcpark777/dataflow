# Docker Environment Configuration
# Copy this to .env.docker and customize for Docker deployment

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# DataFlow Configuration
DATAFLOW_API_HOST=0.0.0.0
DATAFLOW_API_PORT=8000
DATAFLOW_API_URL=http://dataflow-api:8000

DATAFLOW_UI_HOST=0.0.0.0
DATAFLOW_UI_PORT=8501
DATAFLOW_UI_URL=http://localhost:8501

# Spark Configuration
SPARK_APP_NAME=DataFlow-Docker
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=2

# Java Configuration
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/dataflow.log

# Data Storage
DATA_DIR=/app/data
EXPORT_DIR=/app/data/exports
IMPORT_DIR=/app/data/imports
